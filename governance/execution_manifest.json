  },
  "dependency_graph": {
    "services": ["service_acquisition"],
    "service_acquisition": ["qualified_inquiry"],
    "qualified_inquiry": ["brief"],
    "brief": ["quote"],
    "quote": ["paid_start"],
    "paid_start": [],
